{
  "name": "rustregistry",
  "private": true,
  "version": "0.1.15",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ersinkoc/rustregistry.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "version:check": "node scripts/check-version.mjs",
    "check": "npm run version:check && npm run format:check && npm run typecheck && npm test && cargo fmt --all --check && npm run check:rust && npm run test:rust && npm run test:service-fixture && npm run test:shared-dll-fixture",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "scan": "cargo run -p registry-core --bin registry-scan --quiet",
    "check:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "test:rust": "cargo test --workspace",
    "tauri": "tauri",
    "test:service-fixture": "powershell.exe -NoProfile -NonInteractive -File scripts/service-fixture.ps1 -Action verify",
    "test:shared-dll-fixture": "powershell.exe -NoProfile -NonInteractive -File scripts/shared-dll-fixture.ps1 -Action verify"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
